{
  "name": "czy-blog",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=26",
    "npm": ">=11"
  },
  "scripts": {
    "dev:api": "npm --workspace apps/api run dev",
    "dev:web": "npm --workspace apps/web run dev",
    "dev:dashboard": "npm --workspace apps/dashboard run dev",
    "dev": "npm-run-all -p dev:api dev:web dev:dashboard",
    "build:api": "npm --workspace apps/api run build",
    "build:web": "npm --workspace apps/web run build",
    "build:dashboard": "npm --workspace apps/dashboard run build",
    "build": "npm-run-all -s build:api build:web build:dashboard",
    "start:api": "npm --workspace apps/api run start",
    "start:web": "npm --workspace apps/web run start",
    "start:dashboard": "npm --workspace apps/dashboard run start",
    "start": "npm-run-all -p start:api start:web start:dashboard",
    "db:up": "docker compose up -d postgres",
    "db:down": "docker compose down",
    "db:migrate": "npm --workspace apps/api run db:migrate",
    "db:deploy": "npm --workspace apps/api run db:deploy",
    "docs:dev": "vitepress dev docs",
    "docs:build": "vitepress build docs",
    "docs:preview": "vitepress preview docs",
    "lint": "eslint \"{apps,packages}/**/*.{js,jsx,ts,tsx,mjs,cjs}\"",
    "lint:fix": "eslint \"{apps,packages}/**/*.{js,jsx,ts,tsx,mjs,cjs}\" --fix",
    "format": "prettier --write \"{apps,packages}/**/*.{js,jsx,ts,tsx,mjs,cjs,json,css,scss,html}\"",
    "format:check": "prettier --check \"{apps,packages}/**/*.{js,jsx,ts,tsx,mjs,cjs,json,css,scss,html}\"",
    "deps:check": "syncpack lint",
    "deps:fix": "syncpack fix"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.4.1",
    "eslint": "^10.10.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.12.0",
    "mermaid": "^11.17.2",
    "npm-run-all": "^4.1.5",
    "prettier": "^3.9.6",
    "syncpack": "^15.3.3",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.69.0",
    "vitepress": "^1.6.4",
    "vitepress-plugin-mermaid": "^2.0.17"
  }
}
