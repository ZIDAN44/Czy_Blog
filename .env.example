# Czy Blog | Environment
# The only env file in the repo — copy to `.env` at the root; every app loads it.
# Values are local-dev defaults; docker-compose.yml overrides the DB host + API_URL.

# Runtime
# development | production | test.
NODE_ENV=production

# Postgres (Compose only)
POSTGRES_USER=czyblog
POSTGRES_PASSWORD=czyblog
POSTGRES_DB=czyblog
POSTGRES_PORT=5432

# API
DATABASE_URL=postgresql://czyblog:czyblog@localhost:5432/czyblog?schema=public
API_PORT=4000
API_HOST=0.0.0.0
PUBLIC_SITE_URL=http://localhost:3000
# PORT / HOST are fallback aliases (API_PORT ?? PORT, API_HOST ?? HOST) for PaaS
# that inject them; leave commented unless the host requires them.
# PORT=4000
# HOST=0.0.0.0

# API · auth
# Required in production, min 32 chars.
# node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=change-me-to-a-long-random-string
JWT_ISSUER=czy-blog
JWT_AUDIENCE=czy-blog-api
# bcrypt work factor; OWASP floor is 10.
BCRYPT_ROUNDS=12

# API · network
# Exact origins, comma-separated. "*" is refused in production.
CORS_ORIGINS=http://localhost:3000,http://localhost:3001
# false | true | <hop count> | <ip/cidr list>. Enable only behind a proxy you control.
TRUST_PROXY=false

# API · media (S3)
# Private bucket; the API validates and puts objects, readers load via /media.
# S3_BUCKET is required. On AWS credentials are optional (IAM role); self-hosted
# stores need the access key + secret.
S3_BUCKET=czyblog-media
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# Set for a self-hosted S3-compatible server (RustFS, MinIO, …); blank for AWS.
S3_ENDPOINT=
# Path-style addressing; defaults on when S3_ENDPOINT is set. false = virtual-host.
S3_FORCE_PATH_STYLE=
# Browser-facing base for image URLs; defaults to http://localhost:<API_PORT>/media.
MEDIA_PUBLIC_BASE_URL=
MAX_UPLOAD_BYTES=10485760
MEDIA_CLEANUP_INTERVAL_HOURS=24

# Web + Dashboard
# Reader (web) and admin console (dashboard) reach the API here; Compose rewrites
# it to http://api:4000.
API_URL=http://localhost:4000
WEB_PORT=3000
DASHBOARD_PORT=3001
