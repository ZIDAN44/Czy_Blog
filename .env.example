# Czy Blog | Docker Compose environment

# Postgres
POSTGRES_USER=czyblog
POSTGRES_PASSWORD=czyblog
POSTGRES_DB=czyblog
POSTGRES_PORT=5432

# API
DATABASE_URL=postgresql://czyblog:czyblog@postgres:5432/czyblog?schema=public
JWT_SECRET=change-me-to-a-long-random-string
API_PORT=4000
CORS_ORIGINS=http://localhost:3000
PUBLIC_SITE_URL=http://localhost:3000
PUBLIC_UPLOAD_BASE_URL=http://localhost:4000/uploads
MEDIA_CLEANUP_INTERVAL_HOURS=24

# Dashboard
API_URL=http://api:4000
DASHBOARD_PORT=3000
