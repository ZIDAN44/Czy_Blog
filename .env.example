# Czy Blog | Environment
#
# This is the ONLY env file in the repo. Copy it to `.env` at the repo root and
# every consumer picks it up:
#   • docker compose      — `env_file: .env` on the api and dashboard services
#   • the API             — apps/api/src/env.ts loads it by absolute path
#   • prisma CLI          — apps/api/prisma.config.ts loads the same file
#   • the dashboard       — apps/dashboard/next.config.mjs loads the same file
#
# Values below are the local-development defaults (everything on localhost).
# Under Compose, the two host names that only exist on the internal Docker
# network — the database host and API_URL — are overridden in
# docker-compose.yml, so the same file works in both modes untouched.

# ── Postgres (Compose only) ──────────────────────────────────────────────
POSTGRES_USER=czyblog
POSTGRES_PASSWORD=czyblog
POSTGRES_DB=czyblog
POSTGRES_PORT=5432

# ── API ──────────────────────────────────────────────────────────────────
# Host is `localhost` for running the API on your machine. Compose rewrites it
# to the `postgres` service host; point it anywhere else for an external DB
# (and drop the DATABASE_URL override in docker-compose.yml).
DATABASE_URL=postgresql://czyblog:czyblog@localhost:5432/czyblog?schema=public
API_PORT=4000
API_HOST=0.0.0.0
PUBLIC_SITE_URL=http://localhost:3000

# ── API · auth ───────────────────────────────────────────────────────────
# Required in production, min 32 chars.
# node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=change-me-to-a-long-random-string
JWT_ISSUER=czy-blog
JWT_AUDIENCE=czy-blog-api
# bcrypt work factor. OWASP floor is 10.
BCRYPT_ROUNDS=12

# ── API · network ────────────────────────────────────────────────────────
# Exact origins, comma-separated. "*" is refused in production.
CORS_ORIGINS=http://localhost:3000
# false | true | <hop count> | <ip/cidr list>
# Only enable behind a proxy you control — otherwise clients can forge
# X-Forwarded-For and bypass rate limiting.
TRUST_PROXY=false

# ── API · media ──────────────────────────────────────────────────────────
# Relative paths resolve against apps/api.
UPLOAD_DIR=./uploads
PUBLIC_UPLOAD_BASE_URL=http://localhost:4000/uploads
MAX_UPLOAD_BYTES=10485760
MEDIA_CLEANUP_INTERVAL_HOURS=24

# ── Dashboard ────────────────────────────────────────────────────────────
# Where the dashboard's server-side proxy forwards. Compose rewrites this to
# the internal `http://api:4000`.
API_URL=http://localhost:4000
DASHBOARD_PORT=3000
