# Czy Blog | Environment
#
# This is the ONLY env file in the repo. Copy it to `.env` at the repo root and
# every consumer picks it up:
#   • docker compose      — `env_file: .env` on the api and dashboard services
#   • the API             — apps/api/src/env.ts loads it by absolute path
#   • prisma CLI          — apps/api/prisma.config.ts loads the same file
#   • the dashboard       — apps/dashboard/next.config.mjs loads the same file
#
# Values below are the local-development defaults (everything on localhost).
# Under Compose, the two host names that only exist on the internal Docker
# network — the database host and API_URL — are overridden in
# docker-compose.yml, so the same file works in both modes untouched.

# ── Postgres (Compose only) ──────────────────────────────────────────────
POSTGRES_USER=czyblog
POSTGRES_PASSWORD=czyblog
POSTGRES_DB=czyblog
POSTGRES_PORT=5432

# ── API ──────────────────────────────────────────────────────────────────
# Host is `localhost` for running the API on your machine. Compose rewrites it
# to the `postgres` service host; point it anywhere else for an external DB
# (and drop the DATABASE_URL override in docker-compose.yml).
DATABASE_URL=postgresql://czyblog:czyblog@localhost:5432/czyblog?schema=public
API_PORT=4000
API_HOST=0.0.0.0
PUBLIC_SITE_URL=http://localhost:3000

# ── API · auth ───────────────────────────────────────────────────────────
# Required in production, min 32 chars.
# node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=change-me-to-a-long-random-string
JWT_ISSUER=czy-blog
JWT_AUDIENCE=czy-blog-api
# bcrypt work factor. OWASP floor is 10.
BCRYPT_ROUNDS=12

# ── API · network ────────────────────────────────────────────────────────
# Exact origins, comma-separated. "*" is refused in production.
CORS_ORIGINS=http://localhost:3000
# false | true | <hop count> | <ip/cidr list>
# Only enable behind a proxy you control — otherwise clients can forge
# X-Forwarded-For and bypass rate limiting.
TRUST_PROXY=false

# ── API · media (S3) ───────────────────────────────────────────────────────
# Uploads go to S3 or an S3-compatible server (e.g. RustFS). The API validates
# the image bytes and puts the object; the bucket stays PRIVATE. Readers load
# images from the API's own /media route, which streams the object back — so the
# store credentials never leave the server and the bucket is never public.
#
# S3_BUCKET is required. On AWS, credentials are optional (IAM role / default
# credential chain); on a self-hosted store set the access key + secret.
S3_BUCKET=czyblog-media
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# Set S3_ENDPOINT for a self-hosted S3-compatible server (RustFS, MinIO, …).
# Leave it blank for real AWS S3. In Docker this must be reachable from the api
# container — a service name on the compose network, or host.docker.internal.
S3_ENDPOINT=
# Path-style addressing. Defaults to on whenever S3_ENDPOINT is set (what most
# self-hosted servers want); set to false only if yours needs virtual-host style.
S3_FORCE_PATH_STYLE=
# Browser-facing base for image URLs — the API's /media route as the browser
# reaches it. Defaults to http://localhost:<API_PORT>/media; set to your public
# host or domain in production.
MEDIA_PUBLIC_BASE_URL=
MAX_UPLOAD_BYTES=10485760
MEDIA_CLEANUP_INTERVAL_HOURS=24

# ── Dashboard ────────────────────────────────────────────────────────────
# Where the dashboard's server-side proxy forwards. Compose rewrites this to
# the internal `http://api:4000`.
API_URL=http://localhost:4000
DASHBOARD_PORT=3000
