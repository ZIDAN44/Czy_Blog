# Czy Blog | Environment

# ── Postgres ─────────────────────────────────────────────────────────────
POSTGRES_USER=czyblog
POSTGRES_PASSWORD=czyblog
POSTGRES_DB=czyblog
POSTGRES_PORT=5432

# ── API ──────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://czyblog:czyblog@postgres:5432/czyblog?schema=public
API_PORT=4000
PUBLIC_SITE_URL=http://localhost:3000

# ── API · auth ───────────────────────────────────────────────────────────
# Required in production, min 32 chars.
# node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=change-me-to-a-long-random-string
JWT_ISSUER=czy-blog
JWT_AUDIENCE=czy-blog-api
# bcrypt work factor. OWASP floor is 10.
BCRYPT_ROUNDS=12

# ── API · network ────────────────────────────────────────────────────────
# Exact origins, comma-separated. "*" is refused in production.
CORS_ORIGINS=http://localhost:3000
# false | true | <hop count> | <ip/cidr list>
# Only enable behind a proxy you control — otherwise clients can forge
# X-Forwarded-For and bypass rate limiting.
TRUST_PROXY=false

# ── API · media ──────────────────────────────────────────────────────────
PUBLIC_UPLOAD_BASE_URL=http://localhost:4000/uploads
MAX_UPLOAD_BYTES=10485760
MEDIA_CLEANUP_INTERVAL_HOURS=24

# ── Dashboard ────────────────────────────────────────────────────────────
API_URL=http://api:4000
DASHBOARD_PORT=3000
