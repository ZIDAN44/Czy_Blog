// Czy Blog database schema
// Postgres + JSONB for block-editor content

generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  SUPER_ADMIN
  EDITOR
  AUTHOR
  CONTRIBUTOR
}

enum PostStatus {
  DRAFT
  PENDING_REVIEW
  SCHEDULED
  PUBLISHED
  ARCHIVED
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String
  passwordHash String
  role         Role     @default(CONTRIBUTOR)
  bio          String?
  avatarUrl    String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  // Bumped on every password change so tokens issued before it stop verifying.
  tokenVersion Int      @default(0)

  posts   Post[]
  apiKeys ApiKey[]
  media   Media[]
}

model Post {
  id            String     @id @default(cuid())
  slug          String     @unique
  title         String
  excerpt       String?
  content       Json
  coverImageUrl String?
  status        PostStatus @default(DRAFT)
  publishedAt   DateTime?
  scheduledFor  DateTime?
  deletedAt     DateTime?
  viewCount     Int        @default(0)
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  authorId   String
  author     User       @relation(fields: [authorId], references: [id])
  categoryId String?
  category   Category?  @relation(fields: [categoryId], references: [id])
  tags       PostTag[]

  @@index([status, publishedAt])
  @@index([authorId])
  @@index([deletedAt])
}

model Category {
  id          String   @id @default(cuid())
  slug        String   @unique
  name        String
  description String?
  createdAt   DateTime @default(now())

  posts Post[]
}

model Tag {
  id    String    @id @default(cuid())
  slug  String    @unique
  name  String
  posts PostTag[]
}

model PostTag {
  postId String
  tagId  String
  post   Post @relation(fields: [postId], references: [id], onDelete: Cascade)
  tag    Tag  @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([postId, tagId])
  // The compound PK only indexes postId as a leading column; filtering posts
  // by tag needs tagId indexed on its own.
  @@index([tagId])
}

model Media {
  id          String   @id @default(cuid())
  filename    String
  storageKey  String
  url         String
  mimeType    String
  sizeBytes   Int
  width       Int?
  height      Int?
  uploadedById String
  uploadedBy   User    @relation(fields: [uploadedById], references: [id])
  isOrphan     Boolean  @default(false)
  createdAt    DateTime @default(now())

  @@index([uploadedById])
  @@index([isOrphan])
}

model ApiKey {
  id         String    @id @default(cuid())
  name       String
  keyHash    String    @unique
  prefix     String
  ownerId    String
  owner      User      @relation(fields: [ownerId], references: [id])
  lastUsedAt DateTime?
  revokedAt  DateTime?
  createdAt  DateTime  @default(now())

  @@index([ownerId])
}
